---
import DiaryPanel from "@components/DiaryPanel.svelte";
import PasswordProtect from "@components/PasswordProtect.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "../utils/content-utils";

const sortedPostsList = await getSortedPostsList();
---

<MainGridLayout title="日记">
    <PasswordProtect client:only="svelte">
        <DiaryPanel sortedPosts={sortedPostsList} client:only="svelte"></DiaryPanel>
    </PasswordProtect>
    <script is:inline>
        sessionStorage.setItem('last-list-page', window.location.pathname);
    </script>
</MainGridLayout>
