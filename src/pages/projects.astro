---
import { getCollection } from "astro:content";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getPostUrlBySlug } from "@utils/url-utils";

const allPosts = await getCollection("posts", ({ data }) => {
	return import.meta.env.PROD ? data.draft !== true : true;
});

// Filter project posts and sort by published date (newest first)
const projectPosts = allPosts
	.filter((post) => post.slug.startsWith("projects/"))
	.sort(
		(a, b) =>
			new Date(b.data.published).getTime() -
			new Date(a.data.published).getTime(),
	);

// Group by first-level directory
const groupMap = new Map<string, typeof projectPosts>();
for (const post of projectPosts) {
	const parts = post.slug.split("/");
	const group = parts[1] || "其他";
	const list = groupMap.get(group);
	if (list) {
		list.push(post);
	} else {
		groupMap.set(group, [post]);
	}
}

// Sort groups alphabetically
const groups = Array.from(groupMap.entries()).sort((a, b) =>
	a[0].localeCompare(b[0]),
);

// Group name mapping
const groupNames: Record<string, string> = {
	marketing: "大营销平台",
	redis: "Redis 手写",
	spm: "学生成绩管理",
};
---

<MainGridLayout title="项目">
	<script is:inline>
		sessionStorage.setItem('last-list-page', window.location.pathname);
	</script>
	<div class="card-base px-6 py-6">
		<h1 class="text-2xl font-bold mb-6 text-[var(--primary)]">项目</h1>
		
		{groups.length === 0 && (
			<p class="text-50 text-center py-8">暂无项目</p>
		)}

		{groups.map(([group, posts]) => (
			<div class="mb-6">
				<h2 class="text-lg font-bold mb-3 pb-2 border-b border-[var(--line-divider)]">
					{groupNames[group] || group}
					<span class="text-sm text-50 font-normal ml-2">({posts.length}篇)</span>
				</h2>
				<div class="space-y-2">
					{posts.map((post) => (
						<a
							href={getPostUrlBySlug(post.slug)}
							class="flex items-center justify-between py-2 px-3 rounded-lg hover:bg-[var(--btn-plain-bg-hover)] transition group"
						>
							<span class="text-75 group-hover:text-[var(--primary)] transition truncate flex-1">
								{post.data.title}
							</span>
							<span class="text-xs text-30 ml-3 shrink-0">
								{formatDateToYYYYMMDD(post.data.published)}
							</span>
						</a>
					))}
				</div>
			</div>
		))}
	</div>
</MainGridLayout>
